# The solver binaries are build outputs (see the top-level Makefile).  They
# belong in the per-platform wheels only; the sdist stays pure Python, so
# exclude them here -- package_data would otherwise pull whatever happens to
# be present in the working tree into the sdist as well.
exclude problog/bin/darwin/dsharp
exclude problog/bin/darwin/maxsatz
exclude problog/bin/linux/dsharp
exclude problog/bin/linux/maxsatz
exclude problog/bin/windows/dsharp.exe
exclude problog/bin/windows/maxsatz.exe
